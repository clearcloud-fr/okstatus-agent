# /etc/okstatus-agent/okstatus-agent.env — chmod 600, owned by okstatus-agent
AGGREGATOR_URL=https://backend.okstatus.eu
OKSTATUS_AGENT_NAME=dc-paris-01

# Stateless identity (recommended): copy from the Private Agents page.
OKSTATUS_AGENT_ID=
OKSTATUS_AGENT_SECRET=

# OR single-use enrollment token (exchanged on first start, credentials
# persisted in OKSTATUS_CREDENTIALS_FILE).
# OKSTATUS_TOKEN=oksa_live_xxxx
# OKSTATUS_CREDENTIALS_FILE=/var/lib/okstatus-agent/credentials.json

# Optional tuning
# MAX_CONCURRENT_CHECKS=50
# POLL_INTERVAL_MS=2000
# CHECK_TIMEOUT_MS=5000
# HEALTH_PORT=9091
# RUST_LOG=info
# HTTPS_PROXY=http://proxy.corp:3128
